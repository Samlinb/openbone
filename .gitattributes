/.gitattributes text eol=lf
/README.md text eol=lf
/docs/*.md text eol=lf
/src/**/*.java text eol=lf
/src/main/resources/** text eol=lf
/pom.xml text eol=lf
/tools/P0DesktopSmoke.java text eol=lf
/tools/verify-p0.ps1 text eol=lf
/tools/p2/*.py text eol=lf
/samples/p1/*.json -text -whitespace
/verification/** -text -whitespace
/tools/p3/** text eol=lf
# Upstream notices are sealed as exact input bytes, including source-JAR copyright headers.
/src/main/resources/licenses/** -text -whitespace
/tools/p4/** text eol=lf
/tools/p6/*.java text eol=lf
/tools/p6/*.py text eol=lf
/tools/p6/*.ps1 text eol=lf
/tools/p6/*.json text eol=lf
/src/test/resources/regressions/*.json -text -whitespace
/samples/p6/release-demo/** -text -whitespace

# Preserve P8 exported manifests and fixed oracle inputs byte-for-byte.
/samples/p8/** -text -whitespace
/tools/p8/** text eol=lf

/src/test/resources/regressions/p8-atlas-overflow/** -text -whitespace

/src/test/resources/regressions/p8-discrete-signed-zero/** -text -whitespace

/tools/p9/** text eol=lf
/packaging/** text eol=lf
/samples/p9/** -text -whitespace
